---
import { useTranslations, type Locale } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const dayKeys = ["monday","tuesday","wednesday","thursday","friday","saturday","sunday"] as const;

const tz = siteConfig.timezone;
const fmt = new Intl.DateTimeFormat("en-US", { weekday: "long", timeZone: tz });
const todayName = fmt.format(new Date()).toLowerCase();
---

<section class="container-narrow py-24 md:py-32" id="hours">
  <div class="max-w-lg mx-auto">
    <header class="text-center mb-14 reveal">
      <p class="eyebrow mb-4">⌖</p>
      <h2 class="display italic text-[clamp(2.5rem,6vw,4rem)] text-[var(--color-gold-soft)]">
        {t("hours.title")}
      </h2>
      <div class="gold-rule mt-6 max-w-[120px] mx-auto"></div>
    </header>

    <div class="panel p-8 md:p-10 reveal reveal-d1">
      <ul>
        {dayKeys.map((day, i) => {
          const slot = siteConfig.hours[day];
          const isToday = day === todayName;
          return (
            <li class={`flex items-center justify-between py-3.5 ${i < dayKeys.length - 1 ? "border-b border-[var(--color-line)]" : ""}`}>
              <span class="text-[0.78rem] tracking-[0.2em] uppercase font-light"
                style={isToday ? "color:var(--color-gold);font-weight:500;" : "color:var(--color-fg-muted);"}>
                {t(`hours.${day}`)}
                {isToday && <span class="ml-2 text-[var(--color-gold)] opacity-60" aria-label="today">·</span>}
              </span>
              <span class="font-display italic text-[1.05rem]"
                style={isToday
                  ? (slot ? "color:var(--color-gold-soft)" : "color:var(--color-fg-muted)")
                  : "color:var(--color-fg-muted)"}>
                {slot ? `${slot.open} – ${slot.close}` : t("hours.closed")}
              </span>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
