---
import { useTranslations, localizedPath, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative my-20 md:my-32 reveal" aria-label={t("reservation.line")}>
  <div class="relative overflow-hidden border-y border-[var(--color-line-strong)]" style="
    background:
      linear-gradient(180deg,
        oklch(from var(--color-accent-deep) l c h / 0.92),
        oklch(from var(--color-accent) l c h / 0.88)),
      radial-gradient(ellipse at 30% 50%, oklch(from var(--color-gold) l c h / 0.15), transparent 60%),
      radial-gradient(ellipse at 80% 50%, oklch(from var(--color-accent-bright) l c h / 0.12), transparent 55%);
  ">
    <!-- Gold hairlines -->
    <div class="absolute top-0 inset-x-0 h-px opacity-45" style="background: linear-gradient(to right, transparent, var(--color-gold-deep) 30%, var(--color-gold) 50%, var(--color-gold-deep) 70%, transparent);"></div>
    <div class="absolute bottom-0 inset-x-0 h-px opacity-30" style="background: linear-gradient(to right, transparent, var(--color-gold-deep) 30%, var(--color-gold) 50%, var(--color-gold-deep) 70%, transparent);"></div>

    <div class="container-narrow flex flex-col md:flex-row items-center justify-center md:justify-between gap-8 md:gap-16 py-12 md:py-16 text-center md:text-left">
      <div>
        <p class="eyebrow mb-3 text-[var(--color-gold)]">⌖ {t("hero.tonight")}</p>
        <p class="display italic text-2xl md:text-4xl text-[var(--color-gold-soft)] leading-[1.1] max-w-lg">
          {t("reservation.line")}
        </p>
      </div>
      <a href={localizedPath(locale, "/booking")} class="btn-primary shrink-0"
        style="border-color: oklch(from var(--color-gold) l c h / 0.5); color: var(--color-gold-soft);">
        {t("reservation.cta")}
      </a>
    </div>
  </div>
</section>
